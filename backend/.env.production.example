# Copiar a backend/.env EN EL SERVIDOR y completar. NO subir el .env real al repo.

# App
PORT=3001
NODE_ENV=production

# PostgreSQL (local en el droplet)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=distribuidora
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=distribuidora

# TypeORM
DB_SYNCHRONIZE=false
# Las migraciones se corren a mano en el deploy (ver DEPLOY.md), no al arrancar.
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# Auth
# Genera uno con:  openssl rand -hex 32
JWT_SECRET=CAMBIA_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Debe ser EXACTAMENTE el origen con el que abren la app en el navegador.
# Con HTTPS + hostname gratis:  https://104.236.254.247.sslip.io
# Si te quedas en HTTP con IP:  http://TU_IP_PUBLICA
CORS_ORIGIN=https://104.236.254.247.sslip.io
