# Copiar a .env y completar. NO subir .env al repositorio.
# NOTA: Aún NO se migra a PostgreSQL. Estos valores quedan listos para cuando se autorice.

# App
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=distribuidora_del_sol

# TypeORM
# Nunca 'true' fuera de un experimento local: el esquema se administra SOLO por migraciones.
DB_SYNCHRONIZE=false
# Ejecutar migraciones automáticamente al arrancar (dejar en false por ahora).
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# Auth
JWT_SECRET=cambiar-en-produccion
CORS_ORIGIN=http://localhost:3000
